# Relay
PORT=8090
VOIXPE3PER_WS_PORT=8080
VOIXPE3PER_FFMPEG_PATH=ffmpeg
VOIXPE3PER_PAIRING_MODE=relay
VOIXPE3PER_RELAY_URL=wss://voixpe3per-relay.onrender.com/ws
VOIXPE3PER_PUBLIC_WS_URL=
VOIXPE3PER_PAIRING_PAGE_URL=https://voixxpe3per.vercel.app/pair

# Supabase (cloud backend: auth + pairing)
# Dashboard -> Project Settings -> API
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# Discord OAuth is configured inside Supabase:
# Dashboard -> Authentication -> Providers -> Discord
# Add this Redirect URL in Authentication -> URL Configuration:
#   http://localhost:8971/auth/callback   (desktop login)
#   https://YOUR_VERCEL_DOMAIN.vercel.app/pair   (web pairing)
