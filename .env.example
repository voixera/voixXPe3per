# Relay
PORT=8090
VOIXPE3PER_WS_PORT=8080
VOIXPE3PER_FFMPEG_PATH=ffmpeg
VOIXPE3PER_PAIRING_MODE=relay
VOIXPE3PER_RELAY_URL=wss://voixpe3per-relay.onrender.com/ws
VOIXPE3PER_PUBLIC_WS_URL=
VOIXPE3PER_PAIRING_PAGE_URL=https://voixxpe3per.vercel.app/pair

# Supabase
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# Discord OAuth
DISCORD_CLIENT_ID=YOUR_DISCORD_CLIENT_ID
DISCORD_CLIENT_SECRET=YOUR_DISCORD_CLIENT_SECRET
DISCORD_REDIRECT_URL=https://YOUR_VERCEL_DOMAIN.vercel.app/pair

# Server secret. Generate with: openssl rand -hex 32
JWT_SECRET=REPLACE_WITH_LONG_RANDOM_SECRET
