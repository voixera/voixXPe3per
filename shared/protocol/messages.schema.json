{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.voixpe3per/protocol/messages.schema.json",
  "title": "voiXPe3per WebSocket Messages",
  "oneOf": [
    {
      "type": "object",
      "required": ["type", "token", "device"],
      "properties": {
        "type": { "const": "pair.verify" },
        "token": { "type": "string" },
        "room": { "type": "string" },
        "device": { "$ref": "../models/device.schema.json" },
        "capabilities": {
          "type": "object",
          "properties": {
            "encoder": { "enum": ["h264"] },
            "maxFps": { "type": "integer", "minimum": 24, "maximum": 120 }
          }
        }
      }
    },
    {
      "type": "object",
      "required": ["type", "deviceId", "trustSecret"],
      "properties": {
        "type": { "const": "device.reconnect" },
        "deviceId": { "type": "string" },
        "trustSecret": { "type": "string", "minLength": 32 }
      }
    },
    {
      "type": "object",
      "required": ["type", "codec", "width", "height", "targetFps"],
      "properties": {
        "type": { "const": "stream.start" },
        "codec": { "const": "H264" },
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 },
        "targetFps": { "type": "integer", "minimum": 1, "maximum": 120 }
      }
    }
  ]
}
